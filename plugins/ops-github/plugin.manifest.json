{
  "$schema": "../../schemas/plugin-manifest.schema.json",
  "name": "ops-github",
  "displayName": "OPS GitHub",
  "version": "1.6.0",
  "description": "GitHub repos, SemVer version management, and auto-push. Bumps app versions before every push using Conventional Commits. Migrates existing repos from personal GitHub into the approved company org.",
  "author": {
    "name": "Acme Corp",
    "email": "plugins@yourcompany.com"
  },
  "homepage": "https://github.com/acme-org-ops/smart-aiagent-plugins",
  "repository": "https://github.com/acme-org-ops/smart-aiagent-plugins",
  "license": "Apache-2.0",
  "category": "developer-tools",
  "keywords": ["github", "repository", "gh", "private", "push", "ops", "semver", "versioning"],
  "tags": ["devtools", "github"],
  "platforms": [
    "cursor",
    "claude",
    "codex"
  ],
  "components": {
    "skills": "./skills/",
    "agents": "./agents/",
    "commands": "./commands/",
    "rules": "./rules/"
  }
}
